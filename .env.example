# Bhangar.Space - Environment Variables
# Copy this file to .env.local and add your keys.
# If these variables are not provided, the application will automatically
# operate in local demo mode using localStorage and seed listings.

# 1. Supabase Backend & CDN Storage (Optional for local test)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. xAI Grok API (Optional - analyzes listings, prices & elevator fit)
# Get your key from https://console.x.ai/
VITE_GROK_API_KEY=xai-your-api-key
VITE_GROK_MODEL=grok-2-latest
