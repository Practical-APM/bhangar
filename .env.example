# Bhangar.Space - Environment Variables
# Copy this file to .env or .env.local to activate live cloud services.
# If these variables are not set, the app will seamlessly run in local demo mode.

# ==============================================================================
# 1. Supabase Backend, Realtime & Authentication
# ==============================================================================
# Get these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==============================================================================
# 2. Google OAuth 2.0 (Configured inside Supabase Dashboard)
# ==============================================================================
# Setup Steps for Real Google OAuth:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# 2. Configure OAuth Consent Screen:
#    - App Name: Bhangar.Space
#    - User support email: your-email@domain.com
# 3. Create Credentials -> OAuth Client ID:
#    - Application type: Web application
#    - Authorized JavaScript origins:
#        http://localhost:5173
#        https://your-domain.vercel.app (production)
#    - Authorized redirect URIs:
#        https://<your-project-id>.supabase.co/auth/v1/callback
# 4. In Supabase Dashboard -> Authentication -> Providers -> Google:
#    - Toggle "Enable Google provider" to ON
#    - Paste your Google "Client ID" and "Client Secret"
#    - Click Save

# ==============================================================================
# 3. Google Gemini AI Engine
# ==============================================================================
# Free Tier available at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_MODEL=gemini-2.0-flash

